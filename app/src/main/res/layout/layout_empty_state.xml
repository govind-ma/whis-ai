<?xml version="1.0" encoding="utf-8"?>
<!--
  Reusable empty state layout — shows floating shield icon + copy when a list has no items.
  Embed via <include> in any fragment layout and control visibility from Java.
  The float animation is attached programmatically from the host fragment.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/empty_state_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingVertical="40dp"
    android:visibility="gone">

    <!-- Shield icon — translateY float animation driven from code -->
    <ImageView
        android:id="@+id/empty_state_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_shield_check"
        android:contentDescription="Shield protection icon"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/empty_state_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="All clear."
        android:textColor="@color/whis_text_hi"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/empty_state_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No activity yet."
        android:textColor="@color/whis_text_mid"
        android:textSize="14sp"
        android:gravity="center" />

</LinearLayout>
