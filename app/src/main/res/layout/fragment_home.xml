<?xml version="1.0" encoding="utf-8"?>
<!-- HomeFragment layout (UI_PLAN.md §2.4 / §3.1) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/whis_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/whis_spacing_screen_margin"
        android:paddingTop="@dimen/whis_spacing_section"
        android:paddingBottom="@dimen/whis_spacing_section">

        <!-- Top Bar: Title + 3-Dot Menu -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Whis AI"
                style="@style/Whis.TextAppearance.H1" />

            <ImageButton
                android:id="@+id/btn_home_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Options Menu"
                android:src="@android:drawable/ic_menu_more"
                android:tint="@color/whis_text_hi" />

        </RelativeLayout>

        <!-- Ask Whis AI Card -->
        <com.whis.app.ui.components.GlassCardView
            android:id="@+id/card_ask_whis_ai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_item">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/whis_spacing_card_padding">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_circle_trusted">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_learn"
                        android:tint="@color/whis_trusted" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/whis_spacing_item"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ask Whis Anything"
                        style="@style/Whis.TextAppearance.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check a message, UPI ID, or scam pattern in plain language"
                        style="@style/Whis.TextAppearance.Caption" />

                </LinearLayout>

            </LinearLayout>

        </com.whis.app.ui.components.GlassCardView>

        <!-- Activity feed header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_section"
            android:text="Recent Activity"
            style="@style/Whis.TextAppearance.H2" />

        <!-- Filter Chips (All, Calls, Messages, Blocked) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="All"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/whis_bg"
                    android:background="@drawable/bg_chip_active"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_filter_calls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="Calls"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/whis_text_hi"
                    android:background="@drawable/bg_chip_inactive"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_filter_messages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="Messages"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/whis_text_hi"
                    android:background="@drawable/bg_chip_inactive"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_filter_blocked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="Blocked"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/whis_text_hi"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Multi-Select Action Bar (Select All, Unselect All, Delete Selected) — hidden by default, shown on long click -->
        <LinearLayout
            android:id="@+id/bar_multi_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_select_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:text="☑️ Select All"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/whis_text_hi"
                android:background="@drawable/bg_chip_inactive"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_unselect_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:text="⏹️ Unselect All"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/whis_text_hi"
                android:background="@drawable/bg_chip_inactive"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_delete_selected"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🗑️ Delete"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingHorizontal="10dp"
                android:textColor="@color/whis_high_risk"
                android:backgroundTint="@color/whis_high_risk_tint" />

        </LinearLayout>

        <!-- 4. Activity feed RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_activity_feed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <!-- 5. Empty state — shown when no AI-analysed activity yet -->
        <include
            android:id="@+id/home_empty_state"
            layout="@layout/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
