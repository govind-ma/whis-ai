<?xml version="1.0" encoding="utf-8"?>
<!-- Generic AlertDetailFragment layout (UI_PLAN.md §2.4 / §3.1) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/whis_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/whis_spacing_screen_margin"
        android:paddingTop="@dimen/whis_spacing_section"
        android:paddingBottom="@dimen/whis_spacing_section">

        <!-- Top bar: tag + timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.whis.app.ui.components.RiskTag
                android:id="@+id/detail_risk_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/detail_timestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                style="@style/Whis.TextAppearance.Caption" />

        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_item"
            style="@style/Whis.TextAppearance.H1" />

        <!-- Formatted alert copy card (using AlertRenderer confidence language rules) -->
        <com.whis.app.ui.components.StatusCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_section">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analysis Summary"
                    style="@style/Whis.TextAppearance.H2" />

                <TextView
                    android:id="@+id/detail_formatted_copy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/whis_spacing_base"
                    style="@style/Whis.TextAppearance.BodyLarge" />

            </LinearLayout>
        </com.whis.app.ui.components.StatusCard>

        <!-- Technical details card -->
        <com.whis.app.ui.components.StatusCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_item">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detection Details"
                    style="@style/Whis.TextAppearance.H2" />

                <TextView
                    android:id="@+id/detail_risk_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/whis_spacing_base"
                    style="@style/Whis.TextAppearance.Body" />

                <TextView
                    android:id="@+id/detail_identifier_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/whis_spacing_base"
                    style="@style/Whis.TextAppearance.Body" />

                <TextView
                    android:id="@+id/detail_confidence_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/whis_spacing_base"
                    style="@style/Whis.TextAppearance.Body" />

            </LinearLayout>
        </com.whis.app.ui.components.StatusCard>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_section"
            android:orientation="vertical">

            <com.whis.app.ui.components.PrimaryButton
                android:id="@+id/btn_detail_ask_ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Why was this flagged? Ask Whis" />

            <Button
                android:id="@+id/btn_detail_back"
                android:layout_width="match_parent"
                android:layout_height="@dimen/whis_touch_standard"
                android:layout_marginTop="@dimen/whis_spacing_base"
                android:text="Back to Feed"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="@color/whis_text_mid"
                android:background="@android:color/transparent" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
