<?xml version="1.0" encoding="utf-8"?>
<!--
  Chapter Detail Layout — Whis Knowledge Book (LEARN_PLAN.md §2.1)
  Renders the 4-question scam awareness framework.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/whis_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/whis_spacing_screen_margin"
        android:paddingTop="@dimen/whis_spacing_section"
        android:paddingBottom="48dp">

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/pb_lesson_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_lesson_progress" />

        <!-- Chapter Category / Tag Badge -->
        <TextView
            android:id="@+id/tv_chapter_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_base"
            android:text="SCAM MECHANICS"
            style="@style/Whis.TextAppearance.H2"
            android:textColor="@color/whis_trusted" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_lesson_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="The Fake Police Video Call"
            style="@style/Whis.TextAppearance.H1" />

        <!-- Emergency 1930 Helpline Banner -->
        <com.whis.app.ui.components.StatusCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_base">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨 Is this happening right now?"
                        style="@style/Whis.TextAppearance.Caption"
                        android:textStyle="bold"
                        android:textColor="@color/whis_text_hi" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Call 1930 immediately to freeze accounts."
                        style="@style/Whis.TextAppearance.Caption"
                        android:textColor="@color/whis_text_mid" />

                </LinearLayout>

                <Button
                    android:id="@+id/btn_detail_call_1930"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="DIAL 1930"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/whis_bg"
                    android:backgroundTint="@color/whis_trusted"
                    android:paddingHorizontal="12dp" />

            </LinearLayout>

        </com.whis.app.ui.components.StatusCard>

        <!-- 📖 STORY NOTE: What Happens — styled like a story paragraph on parchment -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_section"
            android:text="📖  THE STORY"
            style="@style/Whis.TextAppearance.H2"
            android:textColor="@color/whis_story_border"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/whis_story_bg"
            android:padding="0dp"
            android:orientation="vertical">

            <!-- Parchment accent strip -->
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/whis_story_border"
                android:alpha="0.7" />

            <!-- Story text block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">

                <!-- Left bookmark accent bar -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/whis_story_border"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.5" />

                <TextView
                    android:id="@+id/tv_what_happens"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="@color/whis_story_text"
                    android:fontFamily="serif"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Bottom parchment strip -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/whis_story_border"
                android:alpha="0.3" />
        </LinearLayout>

        <!-- 🧠 WHY IT WORKS — styled as a second story paragraph -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_section"
            android:text="🧠  WHY IT WORKS ON SMART PEOPLE"
            style="@style/Whis.TextAppearance.H2"
            android:textColor="@color/whis_trusted"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/whis_why_bg"
            android:padding="0dp"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/whis_why_border"
                android:alpha="0.5" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/whis_why_border"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.4" />

                <TextView
                    android:id="@+id/tv_why_it_works"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="@color/whis_why_text"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/whis_why_border"
                android:alpha="0.2" />
        </LinearLayout>

        <!-- Q3: What do I do right now if this is happening to me? -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_section"
            android:text="3. SAHI KADAM (WHAT TO DO)"
            style="@style/Whis.TextAppearance.H2"
            android:textColor="@color/whis_trusted" />

        <LinearLayout
            android:id="@+id/container_do_right_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- 3B: GALTI MAT KARNA (WHAT NOT TO DO) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_section"
            android:text="3B. GALTI MAT KARNA (WHAT NOT TO DO)"
            style="@style/Whis.TextAppearance.H2"
            android:textColor="#FF4D4D" />

        <LinearLayout
            android:id="@+id/container_what_not_to_do"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- AI Story Generator Button -->
        <Button
            android:id="@+id/btn_generate_ai_story"
            android:layout_width="match_parent"
            android:layout_height="@dimen/whis_touch_standard"
            android:layout_marginTop="@dimen/whis_spacing_base"
            android:text="✨ Generate AI Scam Story &amp; Unlock Chapter"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#41C85A"
            android:backgroundTint="#152619" />

        <!-- Q4: What does Whis do about this automatically? -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/whis_spacing_section"
            android:text="4. HOW WHIS PROTECTS YOU AUTOMATICALLY"
            style="@style/Whis.TextAppearance.H2"
            android:textColor="@color/whis_trusted" />

        <com.whis.app.ui.components.StatusCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_how_whis_helps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Whis.TextAppearance.BodyLarge"
                    android:textColor="@color/whis_text_hi" />

            </LinearLayout>

        </com.whis.app.ui.components.StatusCard>

        <View
            android:layout_width="0dp"
            android:layout_height="24dp" />

        <!-- Mark as Completed button: Deletes story & auto-generates next AI story -->
        <com.whis.app.ui.components.PrimaryButton
            android:id="@+id/btn_complete_lesson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mark Story as Completed &amp; Load Next AI Story ✨" />

        <!-- Back to Knowledge Book -->
        <Button
            android:id="@+id/btn_lesson_back"
            android:layout_width="match_parent"
            android:layout_height="@dimen/whis_touch_standard"
            android:layout_marginTop="@dimen/whis_spacing_base"
            android:text="Back to Scam Stories"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textColor="@color/whis_text_mid"
            android:background="@android:color/transparent" />

    </LinearLayout>
</ScrollView>
